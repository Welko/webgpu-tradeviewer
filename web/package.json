{
  "name": "trade-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cd ../cpp && cmake --preset web -DTRADEVIEWER_WASM_NAMES=OFF && cmake --build --preset web",
    "build:wasm:dev": "cd ../cpp && cmake --preset web -DTRADEVIEWER_WASM_NAMES=ON && cmake --build --preset web",
    "dev": "npm run build:wasm:dev && vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -b && eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{ts,js,json,html}\" \"../tools/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{ts,js,json,html}\" \"../tools/*.mjs\"",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "posthog-js": "^1.449.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21"
  }
}
